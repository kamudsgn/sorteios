# ─────────────────────────────────────────────────────────────
# Sorteador de Comentários do Instagram — configuração do backend
# Copie para ".env" e preencha. O arquivo .env NUNCA vai para o frontend.
# ─────────────────────────────────────────────────────────────

# Servidor
PORT=3001
# 127.0.0.1 = acessível só nesta máquina (recomendado). Use 0.0.0.0 apenas atrás de autenticação.
HOST=127.0.0.1
# Endereço onde o usuário abre a interface (para onde o OAuth redireciona no final).
# Desenvolvimento: http://localhost:5173 · Produção (npm start): http://localhost:3001
APP_URL=http://localhost:5173

# ── Opção A (mais simples): token gerado no painel da Meta ──
# App Dashboard → Instagram → "API setup with Instagram login" → Generate token
INSTAGRAM_ACCESS_TOKEN=

# ── Opção B: botão "Conectar Instagram" (OAuth) ──
# Instagram App ID / Secret (App Dashboard → Instagram → API setup with Instagram login)
IG_APP_ID=
IG_APP_SECRET=
# Precisa ser HTTPS e estar cadastrado em "Valid OAuth Redirect URIs".
# Ex.: https://SEU-DOMINIO/api/auth/callback  (em dev, use um túnel HTTPS como ngrok)
IG_REDIRECT_URI=

# ── Avançado ──
# Versão da Graph API (deixe vazio para usar a padrão do servidor).
IG_API_VERSION=v24.0
# Para tokens do "Facebook Login for Business" use https://graph.facebook.com e informe IG_USER_ID.
IG_GRAPH_BASE=https://graph.instagram.com
IG_USER_ID=
